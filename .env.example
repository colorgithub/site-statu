# ---- 管理登录（vault OAuth）----
#
# 本服务默认是公开只读的状态页。只有 ADMIN_EMAILS 里的邮箱可以：
#   1. 用 MemoVault 账号登录
#   2. 在页面上编辑「监控站点」与「公告横幅」
#
# 其他人即使走完 OAuth，也会在回调里被立刻清掉会话并打回首页。
#
# 下面五项缺任意一项，页面右上角就不会出现管理登录入口。
# 生成 SESSION_SECRET：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# 会话签名密钥，至少 16 个字符
SESSION_SECRET=""

# 与博客共用同一个 vault
VAULT_ISSUER="https://vault.colordev.space"

# 需要在 vault 的 OAUTH_CLIENTS 里注册一个新的客户端
OAUTH_CLIENT_ID="statu"
OAUTH_CLIENT_SECRET=""

# 必须与 vault 里登记的 redirectUris 完全一致
OAUTH_REDIRECT_URI="https://statu.example.com/auth/callback"

# 管理员邮箱，逗号分隔；必须和 MemoVault 账号的邮箱一致
ADMIN_EMAILS=""

# ---- 可选 ----
# 监听端口，默认取 sites.config.js 里的 port（3000）
# PORT=3000
